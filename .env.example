# ─── Publicação ────────────────────────────────────────────────────────────
# Domínio oficial (com https://). Habilita URL canônica, sitemap e dados
# estruturados. Deixe vazio até o domínio ser definido.
NEXT_PUBLIC_SITE_URL=

# "true" permite indexação por buscadores. Mantenha vazio até o conteúdo
# provisório ser substituído e o site ser publicado oficialmente.
NEXT_PUBLIC_ALLOW_INDEXING=

# ─── Formulário de contato (somente servidor — NUNCA use NEXT_PUBLIC_) ────
# Envio por e-mail via Resend (https://resend.com). Sem estas três variáveis,
# o formulário valida os dados mas informa que o envio não está ativo.
RESEND_API_KEY=
# Caixa que recebe as mensagens do formulário.
CONTACT_TO_EMAIL=
# Remetente em um domínio verificado no Resend, ex.: "Site Servix <site@seudominio.com.br>"
CONTACT_FROM_EMAIL=
